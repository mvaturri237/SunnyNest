# SunnyNest — Environment Variables
# Copy this file to .env and fill in the values.
# .env is gitignored and will NOT be committed.

# Zillow RapidAPI key (required for Zillow scraper)
# Sign up at https://rapidapi.com and subscribe to "ZLLW Working API" by ONEAPI
RAPIDAPI_KEY=

# Realtor.com RapidAPI key (optional — falls back to RAPIDAPI_KEY if not set)
# Subscribe to "Realtor Search" by API_Jeeves on RapidAPI
REALTOR_RAPIDAPI_KEY=

# Email notification password (Gmail app-specific password)
SMTP_PASSWORD=

# Notification recipient email (overrides config.yaml value)
NOTIFICATION_RECIPIENT=

# WhatsApp Business API credentials (Meta Cloud API)
# NOTE: WhatsApp is disabled by default in config.yaml as of 2026-05-10
# (Meta Test Number tokens expire every ~24 h). Telegram is the primary
# push channel — see below.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_PHONE=

# Telegram Bot API credentials (primary push channel as of 2026-05-10)
# One-time bot setup:
#   1. DM @BotFather on Telegram → /newbot → pick a name + username
#      (e.g. sunnynest_alerts_bot) → save the token below as TELEGRAM_BOT_TOKEN
#   2. DM your new bot once (any message) to "open" the chat from its side
#   3. Visit https://api.telegram.org/bot<token>/getUpdates and copy
#      result[0].message.chat.id → save as TELEGRAM_CHAT_ID below
#   4. Flip ``telegram.enabled: true`` in config.yaml
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin panel shared-secret key (optional — if set, requires ?key=<secret> to access /admin/)
# Leave empty or omit for development (no auth required)
ADMIN_SECRET_KEY=
